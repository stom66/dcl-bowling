{
  "name": "dcl-boilerplate",
  "version": "1.0.0",
  "description": "Decentraland SDK7 Template scene",
  "scripts": {
    "start": "sdk-commands start",
    "startClient": "sdk-commands start --explorer-alpha",
    "startBevy": "npx --yes @dcl-regenesislabs/bevy-headless-server@latest --realm=http://127.0.0.1:8000",
    "startHammurabi": "npx --yes @dcl/hammurabi-server@next --realm=http://127.0.0.1:8000",
    "build:ci": "sdk-commands build",
    "deploy:prod": "sdk-commands deploy -t linker-server.decentraland.org --skip-validations true",
    "deploy:testing": "sdk-commands deploy -t linker-server.decentraland.today --skip-validations true",
    "deploy:world": "sdk-commands deploy --target-content https://worlds-content-server.decentraland.org",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "update-skills": "npx skills add decentraland/sdk-skills --all",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "upgrade-sdk:auth-server": "npm i -E @dcl/sdk@auth-server @dcl/js-runtime@auth-server",
    "server-logs": "sdk-commands sdk-server-logs"
  },
  "dependencies": {
    "@dcl-sdk/utils": "^1.4.0",
    "@dcl/js-runtime": "7.27.1-33533530571.commit-451d001",
    "@dcl/sdk": "7.27.1-33533530571.commit-451d001",
    "@stom66/dcl-ui-component-kit": "^0.2.2",
    "cannon-es": "^0.20.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}